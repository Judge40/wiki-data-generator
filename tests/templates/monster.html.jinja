<!DOCTYPE html>
<html lang="en">

<head>
  <title> {{ name }}</title>
</head>

<body>
  <div id="pagecontent">
    <h1 class="title">
      <span>{{ name }}</span>
    </h1>

    <div class="managebox" id="monsterinfo">
      <div class="name">{{ name }}</div>

      <div id="overview">
        <span id="hp">{{ hp }} hp</span>
        <span id="mp">{{ mp }} mp</span>
      </div>

      <div class="stat">
        <span class="stat-req">Str : {{ str }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Offensive Str: {{ offensive_str }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Defensive Str: {{ defensive_str }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Intel: {{ intel }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Offensive Intel: {{ offensive_intel }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Defensive Intel: {{ defensive_intel }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Wisdom: {{ wisdom }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Dex: {{ dex }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Offensive Dex: {{ offensive_dex }}</span>
      </div>
      <div class="stat">
        <span class="stat-req">Defensive Dex: {{ defensive_dex }}</span>
      </div>

      <div class="stat">
        <span class="stat-req">Moral: {{ moral }}</span>
      </div>
    </div>
    <div class="managebox" id="monstermap">
      <a class="title" href id="location"><span> Spawn Location</span></a>
      <ul>
        {% for location in locations %}
        <li>{{ location }}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="managebox" id="monsteritems">
      <a class="title" href id="randomdrop"><span> Drop file</span></a>
      {% set counter = namespace(value=0) %}
      {% for drop_map in drops %}
      <span class="mapname">{{ drop_map.name }}</span>
      {% for item in drop_map['items'] %}
      {% set counter.value = counter.value + 1 %}
      <ul>
        <li>
          <span class="monstername">
            <a href="https://example.com/item.asp?id={{ item.id }}">{{ item.name }}</a>
          </span>
          <input type="checkbox" id="toggle-{{ item.id }}-{{ counter.value }}" class="drop-toggle">
          <label for="toggle-{{ item.id }}-{{ counter.value }}" class="drop-label">Show Drop Rates</label>
          <div class="drop-info">
            {% for rate in item.rates %}
            <span>{{ rate.value }}{% if rate.label %} {{ rate.label }}{% endif %}</span>
            <br>
            {% endfor %}
          </div>
        </li>
        {% endfor %}
      {% endfor %}
      {% for _ in range(counter.value) %}</ul>{% endfor %}
    </div>
  </div>
</body>

</html>
